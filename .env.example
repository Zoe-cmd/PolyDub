# =============================================================================
# TransVideo 配置文件（.env）
# 所有配置均可在 Web UI「设置」页直接修改并保存
# =============================================================================

# ----- 引擎选择 -----
ASR_ENGINE=faster-whisper
TRANSLATE_ENGINE=openai
TTS_ENGINE=index

# ----- 路径 -----
FFMPEG_PATH=D:\Program Files\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=D:\Program Files\ffmpeg\bin\ffprobe.exe
OUTPUT_DIR=output
WORK_DIR=.work

# ----- OpenAI 配置 -----
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.apilio.ai/v1
WHISPER_MODEL=whisper-1
TRANSLATE_MODEL=deepseek-v4-flash
TRANSLATE_MODEL_FALLBACKS=gpt-5.6-luna,deepseek-v4-flash
FASTER_WHISPER_MODEL=large-v3

# ----- Azure TTS (仅 TTS_ENGINE=azure 时需要) -----
# AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# ----- Ollama 本地模型 (仅 TRANSLATE_ENGINE=ollama 时需要) -----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BATCH_SIZE=10
OLLAMA_TIMEOUT=120

# ----- TTS 配音音色 -----
TTS_VOICE_ZH=zh-CN-YunxiNeural
TTS_VOICE_EN=en-US-GuyNeural
TTS_VOICE_JA=ja-JP-KeitaNeural
TTS_VOICE_KO=ko-KR-InJoonNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
# edge-tts 多说话人自动分配音色（仅 TTS_ENGINE=edge 生效）
EDGE_TTS_AUTO_VOICE=true
# edge-tts 男/女音色池（逗号分隔，多说话人时按性别依次分配）
TTS_VOICE_ZH_MALE=zh-CN-YunxiNeural,zh-CN-YunjianNeural
TTS_VOICE_ZH_FEMALE=zh-CN-XiaoxiaoNeural,zh-CN-XiaoyiNeural
TTS_VOICE_EN_MALE=en-US-GuyNeural,en-US-ChristopherNeural
TTS_VOICE_EN_FEMALE=en-US-JennyNeural,en-US-AriaNeural
TTS_VOICE_JA_MALE=ja-JP-KeitaNeural,ja-JP-DaichiNeural
TTS_VOICE_JA_FEMALE=ja-JP-NanamiNeural,ja-JP-AyakaNeural
TTS_VOICE_KO_MALE=ko-KR-InJoonNeural,ko-KR-HyunsuNeural
TTS_VOICE_KO_FEMALE=ko-KR-SunHiNeural,ko-KR-JiMinNeural

# ----- IndexTTS 2 (本地 GPU) -----
INDEX_TTS_REPO_DIR=C:/Users/12439/agent project/public/index-tts
INDEX_TTS_MODEL_DIR=checkpoints_25
# INDEX_TTS_REF_AUDIO=
INDEX_TTS_USE_FP16=true
INDEX_TTS_USE_DEEPSPEED=false
INDEX_TTS_USE_ACCEL=true
INDEX_TTS_USE_TORCH_COMPILE=true
INDEX_TTS_USE_CUDA_KERNEL=false

# ----- 字幕配置 -----
SUBTITLE_STYLE=single
SUBTITLE_FONT=Arial
SUBTITLE_FONTSIZE=50
SUBTITLE_PRIMARY_COLOR=&H00FFFFFF
SUBTITLE_OUTLINE_COLOR=&H00000000
SUBTITLE_OUTLINE_WIDTH=2
SUBTITLE_MARGIN_V=5
SUBTITLE_MAX_WIDTH_PERCENT=0.9
SUBTITLE_MAX_LINES=1
SUBTITLE_OVERFLOW_MODE=split

# ----- 音频配置 -----
AUDIO_KEEP_ORIGINAL=false
AUDIO_ORIGINAL_VOLUME=0.15
SEGMENT_SENTENCE_ALIGN=true

# ----- Google 翻译 -----
GOOGLE_TRANSLATE_URL=https://translate.googleapis.com/translate_a/single

# ----- 网络配置 -----
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
NETWORK_PROXY=http://127.0.0.1:7897
NETWORK_TIMEOUT=60
TIKTOK_COOKIES_BROWSER=edge

# ----- 人声分离 & 其他 -----
SEPARATE_VOCALS=true
VOCAL_SEPARATION_MODEL=UVR-MDX-NET-Voc_FT.onnx
KEEP_NONSPEECH_ORIGINAL=false
ACCOMPANIMENT_VOLUME=1
YOUTUBE_COOKIES_FILE=C:\Users\12439\agent project\kimi code\视频翻译\youtube_cookies.txt

# ----- HuggingFace -----
HF_TOKEN=YOUR_HF_TOKEN_HERE
TTS_VOICE_ES=es-ES-ElviraNeural
TTS_VOICE_AR=ar-EG-SalmaNeural
TTS_VOICE_ES_MALE=es-AR-TomasNeural,es-BO-MarceloNeural,es-CL-LorenzoNeural,es-CO-GonzaloNeural,es-CR-JuanNeural,es-CU-ManuelNeural,es-DO-EmilioNeural,es-EC-LuisNeural,es-SV-RodrigoNeural,es-GQ-JavierNeural,es-GT-AndresNeural,es-HN-CarlosNeural,es-MX-JorgeNeural,es-NI-FedericoNeural,es-PA-RobertoNeural,es-PY-MarioNeural,es-PE-AlexNeural,es-PR-VictorNeural,es-ES-AlvaroNeural,es-US-AlonsoNeural,es-UY-MateoNeural,es-VE-SebastianNeural
TTS_VOICE_ES_FEMALE=es-AR-ElenaNeural,es-BO-SofiaNeural,es-CL-CatalinaNeural,es-CO-SalomeNeural,es-ES-XimenaNeural,es-CR-MariaNeural,es-CU-BelkysNeural,es-DO-RamonaNeural,es-EC-AndreaNeural,es-SV-LorenaNeural,es-GQ-TeresaNeural,es-GT-MartaNeural,es-HN-KarlaNeural,es-MX-DaliaNeural,es-NI-YolandaNeural,es-PA-MargaritaNeural,es-PY-TaniaNeural,es-PE-CamilaNeural,es-PR-KarinaNeural,es-ES-ElviraNeural,es-US-PalomaNeural,es-UY-ValentinaNeural,es-VE-PaolaNeural
TTS_VOICE_AR_MALE=ar-DZ-IsmaelNeural,ar-BH-AliNeural,ar-EG-ShakirNeural,ar-IQ-BasselNeural,ar-JO-TaimNeural,ar-KW-FahedNeural,ar-LB-RamiNeural,ar-LY-OmarNeural,ar-MA-JamalNeural,ar-OM-AbdullahNeural,ar-QA-MoazNeural,ar-SA-HamedNeural,ar-SY-LaithNeural,ar-TN-HediNeural,ar-AE-HamdanNeural,ar-YE-SalehNeural
TTS_VOICE_AR_FEMALE=ar-DZ-AminaNeural,ar-BH-LailaNeural,ar-EG-SalmaNeural,ar-IQ-RanaNeural,ar-JO-SanaNeural,ar-KW-NouraNeural,ar-LB-LaylaNeural,ar-LY-ImanNeural,ar-MA-MounaNeural,ar-OM-AyshaNeural,ar-QA-AmalNeural,ar-SA-ZariyahNeural,ar-SY-AmanyNeural,ar-TN-ReemNeural,ar-AE-FatimaNeural,ar-YE-MaryamNeural
